[Unit]
Description=Home Dashboard frontend (Vite dev server)
After=dashboard-backend.service
Wants=dashboard-backend.service

[Service]
Type=simple
WorkingDirectory=%h/home-dashboard/frontend
ExecStart=/usr/bin/npm run dev -- --port 3300 --host 127.0.0.1
Restart=always
RestartSec=5
Environment=NODE_ENV=development

[Install]
WantedBy=default.target
